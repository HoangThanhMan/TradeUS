# =============================================================================
# TradeUS — production environment
#
# Copy to `.env` on the server and fill in real values:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored. Never commit it: the Gemini key that used to live in
# services/sentiment-service/app/config.py was suspended by Google precisely
# because it was committed to a public repo.
#
# Generate the secrets below with:
#     openssl rand -base64 36
# =============================================================================

# --- Infrastructure credentials ---------------------------------------------
# Used to build the Mongo/RabbitMQ connection strings in docker-compose.prod.yml.
# Change all of these. The defaults in docker-compose.dev.yml (admin/password,
# guest/guest) are for local development only.
MONGO_ROOT_USER=tradex_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo

RABBITMQ_USER=tradex
RABBITMQ_PASSWORD=CHANGE_ME_rabbit

REDIS_PASSWORD=CHANGE_ME_redis

# --- Application secrets -----------------------------------------------------
# JWT_SECRET signs every access/refresh token. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google Gemini -----------------------------------------------------------
# Used by sentiment-service (analysis), chat-agent-service (agent + embeddings)
# and apps/web. Get one at https://aistudio.google.com/apikey
#
# If left empty the platform still runs: sentiment-service falls back to its
# keyword heuristic and chat-agent-service falls back to its rule-based planner.
# Both report the degradation in /health and in stored records.
GEMINI_API_KEY=

# Google gỡ model khá thường xuyên — `gemini-1.5-flash` và `gemini-2.0-flash` mà
# repo này từng hardcode đều đã biến mất ("no longer available"). Khi API bắt đầu
# trả 404, đổi tên model ở đây rồi `dc up -d`, không cần build lại.
#
# Xem danh sách model key của bạn còn dùng được:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.6-flash

# Đổi model embedding = đổi số chiều vector (models/embedding-001 cũ: 768,
# gemini-embedding-001: 3072). Đổi rồi phải ingest lại Qdrant với --recreate.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- AI backend selection ----------------------------------------------------
# sentiment-service: gemini | local
#   local needs the ML extras baked into the image (requirements-local.txt)
#   and the artifacts in training/artifacts.
SENTIMENT_BACKEND=gemini
LOCAL_MODEL_VARIANT=base

# chat-agent-service: gemini | rules
AGENT_BACKEND=gemini
# chat-agent-service embeddings: gemini | local
# Must match whatever the Qdrant collection was built with — the two produce
# different vector widths and cannot share a collection.
EMBEDDING_BACKEND=gemini

# --- Frontend ----------------------------------------------------------------
# Tất cả biến NEXT_PUBLIC_* được nhúng vào bundle lúc BUILD, không đọc lúc chạy.
# Đổi giá trị ở đây phải `dc build web` lại, `dc restart web` không ăn.
#
# Phải có /api/v1: api-gateway dùng setGlobalPrefix('api/v1'). Ghi thiếu /v1 là
# 404 toàn bộ REST, kể cả login.
NEXT_PUBLIC_API_URL=https://ten-mien-cua-ban.com/api/v1

# Ba namespace socket.io riêng biệt. Host là domain, path là tên namespace;
# transport /socket.io/ do nginx proxy. KHÔNG có biến NEXT_PUBLIC_WS_URL nào
# trong code — đặt tên sai thì giá realtime, alert và sentiment chết im lặng.
NEXT_PUBLIC_PRICE_WS_URL=https://ten-mien-cua-ban.com/prices
NEXT_PUBLIC_ALERT_WS_URL=https://ten-mien-cua-ban.com/alerts
NEXT_PUBLIC_SENTIMENT_WS_URL=https://ten-mien-cua-ban.com/sentiment

# --- CORS --------------------------------------------------------------------
# Dùng cho api-gateway và cả 2 ws-gateway. Nhiều origin thì phân cách bằng dấu
# phẩy, nhớ kể cả biến thể www nếu bạn trỏ cả hai.
CORS_ORIGINS=https://ten-mien-cua-ban.com

# --- Data collection ---------------------------------------------------------
BINANCE_SYMBOLS=btcusdt,ethusdt,bnbusdt,solusdt,xrpusdt

# Reddit collector (optional — leave empty to collect from Yahoo only)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Email -------------------------------------------------------------------
# console = chỉ ghi log, không gửi thật. Đổi sang smtp khi đã điền SMTP_* dưới.
EMAIL_STRATEGY=console

# Chỉ dùng khi EMAIL_STRATEGY=smtp. Với Gmail phải là App Password 16 ký tự
# (https://myaccount.google.com/apppasswords), không phải mật khẩu tài khoản.
# SMTP_FROM_EMAIL để trống thì lấy theo SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TradeUS
