# Collector Price Service Environment Variables

# Service Configuration
NODE_ENV=development
LOG_LEVEL=info

# Binance WebSocket Configuration
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# Comma-separated list of trading pairs (lowercase)
BINANCE_SYMBOLS=btcusdt,ethusdt,bnbusdt

# Stream type: miniTicker, kline_1m, kline_5m, kline_15m, kline_1h, kline_4h, kline_1d
BINANCE_STREAM_TYPE=miniTicker

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=tradex.prices
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY_PREFIX=price

# Reconnection Configuration
RECONNECT_INTERVAL_MS=5000
MAX_RECONNECT_ATTEMPTS=10
