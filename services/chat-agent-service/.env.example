# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8006

# MongoDB - source of the articles to embed
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASES=tradex_sentiment,tradex
COLLECTED_NEWS_COLLECTION=collected_news

# Qdrant
# Leave QDRANT_PATH empty to use the server at QDRANT_URL (docker-compose).
# Set it to a directory to use an embedded on-disk store instead - useful for
# running the ingestion and search scripts without Docker.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_COLLECTION=news_chunks

# Embeddings
# gemini -> Google embedding API (768-dim), needs GEMINI_API_KEY
# local  -> sentence encoder on CPU (384-dim), no key required
#           requires the extras: pip install -r requirements-local.txt
#
# The two produce different vector widths and cannot share a collection.
# Switching backends means re-running ingestion with --recreate.
EMBEDDING_BACKEND=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=models/embedding-001
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16

# Downstream services called by the agent tools
PREDICTION_SERVICE_URL=http://localhost:8002
SENTIMENT_SERVICE_URL=http://localhost:8001
TOOL_TIMEOUT=10.0

# Agent loop
# gemini -> real Gemini function calling (needs GEMINI_API_KEY)
# rules  -> deterministic keyword planner over the same tools, no LLM
# Gemini falls back to rules on any failure, so /chat always answers.
AGENT_BACKEND=gemini
GEMINI_MODEL=gemini-2.0-flash
MAX_TOOL_ROUNDS=3
STREAM_DELAY_MS=12
WARMUP_ON_STARTUP=true

# CORS
CORS_ORIGINS=*
