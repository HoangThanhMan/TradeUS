# Environment
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8001

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ENABLE_RABBITMQ=true
ENABLE_RABBITMQ_CONSUMER=true

# Sentiment Alert Threshold (0.0 to 1.0)
# Trigger alert when |sentiment| >= threshold
SENTIMENT_ALERT_THRESHOLD=0.8

# Redis (for future use)
REDIS_URL=redis://localhost:6379

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=tradex_sentiment

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
USE_MOCK_LLM=true

# Sentiment Backend Selection
# gemini -> call the Gemini API (default)
# local  -> score with the local encoder (app/ml/local_model.py); Gemini stays
#           the fallback, so a broken local model degrades but never breaks
SENTIMENT_BACKEND=gemini

# Local backend (only read when SENTIMENT_BACKEND=local)
# Requires the ML extras: pip install -r requirements-local.txt
#
# student -> the LoRA adapter from training/train_distill.py
# base    -> the public checkpoint with no adapter
#
# Measured on the hand-labelled set (training/report.md):
#   base    66.0% bucket accuracy
#   student 58.0% bucket accuracy
# The untrained base is currently the better local model, because the student
# was trained on keyword-fallback labels. Revisit after retraining on real
# Gemini labels.
LOCAL_MODEL_VARIANT=base
LOCAL_MODEL_DIR=training/artifacts
LOCAL_MODEL_BASE=mrm8488/distilroberta-finetuned-financial-news-sentiment-analysis
LOCAL_MAX_LENGTH=256
LOCAL_MODEL_DEVICE=
LOCAL_MODEL_WARMUP=true

# Reddit API Configuration
# Get credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=TradeX-Sentiment-Bot/1.0
REDDIT_SUBREDDITS=cryptocurrency,bitcoin,ethereum,CryptoMarkets
REDDIT_POST_LIMIT=25

# Yahoo Finance Configuration
YAHOO_SYMBOLS=BTC-USD,ETH-USD,BNB-USD,SOL-USD,XRP-USD
YAHOO_NEWS_LIMIT=10
# Scheduler Configuration
# Automatic news collection every N seconds
ENABLE_SCHEDULER=true
COLLECTION_INTERVAL_SECONDS=300  # 5 minutes
COLLECTION_LIMIT=10
COLLECTION_ANALYZE_IMMEDIATELY=true