# Service Configuration
SERVICE_NAME=prediction-service
VERSION=0.1.0
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8002
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ENABLE_RABBITMQ=true
ENABLE_RABBITMQ_CONSUMER=true

# Redis (for caching predictions)
REDIS_URL=redis://localhost:6379

# MongoDB (for storing predictions history)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=tradex_predictions

# Model Configuration
MODEL_PATH=models/crypto_predictor_btcusdt.pt
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1h

# Sentiment Service
SENTIMENT_SERVICE_URL=http://localhost:8001

# Prediction Settings
PREDICTION_CACHE_TTL=60
PRICE_BUFFER_SIZE=100
