# Environment
ENVIRONMENT=development
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8004

# Logging
LOG_LEVEL=INFO

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis (cooldown)
REDIS_URL=redis://localhost:6379

# Cooldown period in seconds
ALERT_COOLDOWN_SECONDS=300

# Symbol Subscription Service URL
SUBSCRIPTION_SERVICE_URL=http://localhost:8005

# Email exchange
EMAIL_EXCHANGE=email.exchange
EMAIL_ROUTING_KEY=email.send.alert
